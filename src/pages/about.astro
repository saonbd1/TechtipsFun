---
import Layout from '../layouts/BlogPost.astro';

const siteUrl = new URL('/', Astro.site);
const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${siteUrl.href}about/#webpage`,
      url: `${siteUrl.href}about/`,
      name: 'About SaonBD | Tech Tips in Fun',
      description: 'Meet SaonBD, the creator of TechTips.fun and a longtime explorer of SEO, AI, open source, privacy, and Web3.',
      isPartOf: { '@id': `${siteUrl.href}#website` },
      mainEntity: { '@id': `${siteUrl.href}about/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl.href}about/#person`,
      name: 'SaonBD',
      url: `${siteUrl.href}about/`,
      description: 'SEO, AI, open source, privacy, and Web3 writer and creator of Tech Tips in Fun.',
      image: new URL('/portrait.webp', Astro.site).href,
      sameAs: ['https://x.com/ayenaldewan/', 'https://github.com/saonbd1/'],
      worksFor: { '@id': `${siteUrl.href}#organization` },
    },
  ],
};
---

<Layout
  title="About SaonBD | Tech Tips in Fun"
  description="Meet SaonBD, the creator of Tech Tips in Fun and a longtime explorer of SEO, AI, open source, privacy, and Web3."
  pubDate={new Date()}
  heroImage="/portrait.webp"
  schema={aboutSchema}
>
  <div class="about-page">
    <section class="about-intro" aria-labelledby="about-heading">
      <div class="intro-copy">
        <p class="eyebrow">ABOUT THE CREATOR</p>
        <h2 id="about-heading">Turning complex technology into useful next steps.</h2>
        <p class="lead">I’m SaonBD, the person behind Tech Tips in Fun — a practical corner of the web for people who like to understand how their tools really work.</p>
        <div class="quick-links" aria-label="Quick links">
          <a href="https://x.com/ayenaldewan/">Follow on X <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/saonbd1/">View my GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="profile-card" aria-label="Profile summary">
        <div class="monogram" aria-hidden="true">SB</div>
        <p class="profile-name">SaonBD</p>
        <p class="profile-role">SEO · AI · Open source · Web3</p>
        <div class="profile-rule"></div>
        <p class="profile-note">Curious by default. Practical by design.</p>
      </aside>
    </section>

    <section class="story-section" aria-labelledby="story-heading">
      <div class="section-label"><span>01</span><span>THE STORY</span></div>
      <div class="section-content">
        <h3 id="story-heading">A decade of learning in public</h3>
        <p>My journey began in 2010 with Search Engine Optimization. I spent years studying search behavior, content systems, and the small technical details that help good ideas reach the right people. That foundation taught me to look past the surface and ask how digital systems work underneath.</p>
        <p>Today, that same curiosity takes me into artificial intelligence, Linux, privacy-first infrastructure, and blockchain. I enjoy translating fast-moving technical ideas into clear explanations, honest experiments, and guides that readers can use immediately.</p>
      </div>
    </section>

    <section class="focus-section" aria-labelledby="focus-heading">
      <div class="section-label"><span>02</span><span>WHAT I EXPLORE</span></div>
      <div class="section-content">
        <h3 id="focus-heading">Ideas worth testing, tools worth keeping</h3>
        <div class="focus-grid">
          <article class="focus-card"><span class="card-number">01</span><h4>AI in practice</h4><p>Local models, useful tools, and real workflows without the hype.</p></article>
          <article class="focus-card"><span class="card-number">02</span><h4>Open systems</h4><p>Linux, self-hosting, networking, and the joy of understanding the stack.</p></article>
          <article class="focus-card"><span class="card-number">03</span><h4>Digital independence</h4><p>Privacy, resilient infrastructure, and technology that keeps you in control.</p></article>
        </div>
      </div>
    </section>

    <section class="closing-section" aria-labelledby="closing-heading">
      <p class="eyebrow">A NOTE FOR READERS</p>
      <h3 id="closing-heading">Build a calmer, smarter relationship with technology.</h3>
      <p>Thanks for visiting TechTips.fun. Whether you arrived for an AI guide, a Linux shortcut, or a better way to protect your digital life, I hope you leave with something useful—and a question worth exploring next.</p>
    </section>
  </div>
</Layout>

<style>
  .about-page {
    --ink: #1f2430;
    --muted: #586174;
    --line: #e7e8ee;
    --accent: #6756d8;
    --accent-soft: #f2efff;
    color: var(--ink);
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  .about-intro {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 2.5rem;
    align-items: end;
    padding: 1.75rem 0 3.5rem;
    border-bottom: 1px solid var(--line);
  }

  .eyebrow,
  .section-label,
  .card-number {
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .eyebrow { margin: 0 0 1.25rem; }
  .intro-copy h2 { margin: 0; color: var(--ink); font-size: clamp(2rem, 4.3vw, 3.8rem); letter-spacing: -0.055em; line-height: 1.04; }
  .lead { max-width: 34rem; margin: 1.7rem 0 0; color: var(--muted); font-size: 1.1rem; line-height: 1.6; }

  .quick-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.4rem; margin-top: 1.5rem; }
  .quick-links a { color: var(--ink); font-size: 0.9rem; font-weight: 700; text-decoration: none; border-bottom: 1px solid var(--ink); padding-bottom: 0.18rem; }
  .quick-links a:hover { color: var(--accent); border-color: var(--accent); }
  .quick-links span { color: var(--accent); margin-left: 0.2rem; }

  .profile-card { padding: 1.5rem; border: 1px solid #dedcf5; border-radius: 1.25rem; background: linear-gradient(145deg, var(--accent-soft), #fff 75%); box-shadow: 0 1rem 2rem rgba(54, 44, 126, 0.05); }
  .monogram { display: grid; width: 3.5rem; height: 3.5rem; place-items: center; border-radius: 50%; background: var(--accent); color: #fff; font-size: 1rem; font-weight: 800; }
  .profile-name { margin: 1.25rem 0 0.25rem; color: var(--ink); font-size: 1.3rem; font-weight: 800; }
  .profile-role { margin: 0; color: var(--muted); font-size: 0.85rem; line-height: 1.5; }
  .profile-rule { width: 2rem; height: 2px; margin: 1.25rem 0 0.75rem; background: var(--accent); }
  .profile-note { margin: 0; color: var(--ink); font-size: 0.9rem; font-style: italic; line-height: 1.5; }

  .story-section,
  .focus-section { display: grid; grid-template-columns: 0.3fr 1.7fr; gap: 2rem; padding: 3rem 0; border-bottom: 1px solid var(--line); }
  .section-label { display: flex; gap: 0.7rem; align-items: baseline; color: var(--muted); }
  .section-label span:first-child { color: var(--accent); }
  .story-section h3,
  .focus-section h3,
  .closing-section h3 { margin: 0; color: var(--ink); font-size: clamp(1.4rem, 2.6vw, 1.95rem); letter-spacing: -0.035em; line-height: 1.14; }
  .story-section p { max-width: 42rem; margin: 1.25rem 0 0; color: var(--muted); font-size: 1rem; line-height: 1.7; }

  .focus-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .focus-card { padding: 1.25rem; border: 1px solid var(--line); border-radius: 0.75rem; background: #fff; }
  .focus-card h4 { margin: 1.25rem 0 0.5rem; color: var(--ink); font-size: 1rem; }
  .focus-card p { margin: 0; color: var(--muted); font-size: 0.88rem; line-height: 1.5; }

  .closing-section { margin: 3rem 0 1rem; padding: 2rem; border-radius: 1rem; background: var(--ink); color: #fff; }
  .closing-section .eyebrow { color: #bdb5ff; }
  .closing-section h3 { color: #fff; }
  .closing-section > p:last-child { margin: 1.25rem 0 0; color: #c7cbd7; line-height: 1.6; }

  @media (max-width: 900px) {
    .about-intro { grid-template-columns: 1fr; gap: 2rem; align-items: start; }
    .profile-card { max-width: 350px; }
  }

  @media (max-width: 768px) {
    .about-intro { padding: 1rem 0 2.5rem; }
    .story-section, .focus-section { grid-template-columns: 1fr; gap: 1rem; padding: 2.5rem 0; }
    .section-label { margin-bottom: 0.5rem; }
    .intro-copy h2 { font-size: 2.3rem; }
  }

  @media (max-width: 480px) {
    .intro-copy h2 { font-size: 2rem; }
    .lead { font-size: 1rem; }
    .closing-section { padding: 1.5rem; }
    .focus-grid { grid-template-columns: 1fr; }
  }
</style>
