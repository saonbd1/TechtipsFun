{
	"name": "astro-blog-starter-template",
	"description": "Build a personal website, blog, or portfolio with Astro.",
	"cloudflare": {
		"label": "Astro Framework Starter",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/394ca3c9-d351-4036-035a-9f6dfa26dd00/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/f40a6577-eed5-4f3e-cef4-b5ef0a1be100/preview",
		"publish": true
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.2.4",
		"@astrojs/mdx": "^7.0.8",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"astro": "^7.2.6",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"sharp": "^0.35.3",
		"wrangler": "4.88.0"
	},
	"engines": {
		"node": ">=22"
	},
	"private": true,
	"scripts": {
		"astro": "astro",
		"generate:assets": "node scripts/generate-social-assets.mjs",
		"cards:tips": "node scripts/generate-tip-cards.mjs",
		"optimize:images": "node scripts/optimize-images.mjs",
		"check:links": "node scripts/check-links.mjs",
		"check:og-cards": "node scripts/check-og-cards.mjs",
		"test:admin": "node --test scripts/tests/test-admin-app.mjs scripts/tests/test-admin-smoke.mjs",
		"share:linkedin": "node scripts/share-to-linkedin.mjs",
		"submit:indexnow": "node scripts/submit-indexnow.mjs",
		"build": "npm run generate:assets && npm run optimize:images && astro build && node scripts/check-og-cards.mjs",
		"cf-typegen": "wrangler types",
		"check": "astro build && tsc && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "astro dev",
		"preview": "astro build && wrangler dev"
	},
	"type": "module"
}
