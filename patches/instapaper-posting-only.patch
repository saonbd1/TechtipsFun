From 0000000000000000000000000000000000000004 Mon Sep 17 00:00:00 2001
From: Saon Islam <saonbd33@gmail.com>
Date: Tue, 3 Nov 2026 09:45:00 +0000
Subject: [PATCH] ci(instapaper): keep the posting automation, drop the /read plumbing

The /read page is gone (79fdaa5) but saving your own posts into your own
Instapaper account is private and harmless, so the posting side stays:

- instapaper-on-publish.yml: drops the "Sync Instapaper bookmarks" and
  "Commit and push updated bookmarks" steps (both only fed the removed page)
- schedule-posts.yml: drops the same two steps, keeps "Add new post to
  Instapaper", and removes a stray comment fragment from its last line
- deletes daily-read-link.yml (the daily rotation only existed to stock
  /read; skip that hunk if you want to keep it anyway)

Apply, commit, push, then delete this file.
---
diff --git a/.github/workflows/daily-read-link.yml b/.github/workflows/daily-read-link.yml
deleted file mode 100644
index 1373719..0000000
--- a/.github/workflows/daily-read-link.yml
+++ /dev/null
@@ -1,59 +0,0 @@
-name: Daily read link
-
-# Every day at 09:00 UTC, pick the next unposted link from data/read-queue.json,
-# add it to your Instapaper "Tech News" folder, then sync that folder's bookmarks
-# into data/instapaper-bookmarks.json so the /read page on techtips.fun refreshes.
-#
-# The folder is configurable with the repository variable INSTAPAPER_FOLDER
-# (Settings → Secrets and variables → Actions → Variables). Default: "Tech News".
-#
-# Important: never put "[skip ci]" in the sync commit message below. Cloudflare
-# Workers Builds skips those commits, so /read would never rebuild.
-
-on:
-  schedule:
-    - cron: "0 9 * * *"
-  workflow_dispatch:
-
-permissions:
-  contents: write
-
-jobs:
-  daily-link:
-    runs-on: ubuntu-latest
-    steps:
-      - name: Check out repository
-        uses: actions/checkout@v4
-
-      - name: Set up Node.js
-        uses: actions/setup-node@v4
-        with:
-          node-version: 22
-
-      - name: Add next link from read queue to Instapaper
-        env:
-          INSTAPAPER_CONSUMER_KEY: ${{ secrets.INSTAPAPER_CONSUMER_KEY }}
-          INSTAPAPER_CONSUMER_SECRET: ${{ secrets.INSTAPAPER_CONSUMER_SECRET }}
-          INSTAPAPER_EMAIL: ${{ secrets.INSTAPAPER_EMAIL }}
-          INSTAPAPER_PASSWORD: ${{ secrets.INSTAPAPER_PASSWORD }}
-          INSTAPAPER_FOLDER: ${{ vars.INSTAPAPER_FOLDER || 'Tech News' }}
-        run: node scripts/daily-read-link.mjs
-
-      - name: Sync Instapaper bookmarks to local JSON
-        env:
-          INSTAPAPER_CONSUMER_KEY: ${{ secrets.INSTAPAPER_CONSUMER_KEY }}
-          INSTAPAPER_CONSUMER_SECRET: ${{ secrets.INSTAPAPER_CONSUMER_SECRET }}
-          INSTAPAPER_EMAIL: ${{ secrets.INSTAPAPER_EMAIL }}
-          INSTAPAPER_PASSWORD: ${{ secrets.INSTAPAPER_PASSWORD }}
-          INSTAPAPER_FOLDER: ${{ vars.INSTAPAPER_FOLDER || 'Tech News' }}
-        run: node scripts/sync-instapaper-bookmarks.mjs
-
-      - name: Commit and push updated bookmarks
-        run: |
-          set -euo pipefail
-          git config user.name "github-actions[bot]"
-          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
-          git add -f data/instapaper-bookmarks.json data/read-queue-state.json
-          git diff --cached --quiet && exit 0
-          git commit -m "chore: sync Instapaper bookmarks"
-          git push
diff --git a/.github/workflows/instapaper-on-publish.yml b/.github/workflows/instapaper-on-publish.yml
index d4271fc..11cb00a 100644
--- a/.github/workflows/instapaper-on-publish.yml
+++ b/.github/workflows/instapaper-on-publish.yml
@@ -81,22 +81,3 @@ jobs:
             URL="${SITE_URL}/blog/${slug}/"
             node scripts/add-instapaper-bookmark.mjs "$URL" "$TITLE" "New post from techtips.fun"
           done
-
-      - name: Sync Instapaper bookmarks to local JSON
-        env:
-          INSTAPAPER_CONSUMER_KEY: ${{ secrets.INSTAPAPER_CONSUMER_KEY }}
-          INSTAPAPER_CONSUMER_SECRET: ${{ secrets.INSTAPAPER_CONSUMER_SECRET }}
-          INSTAPAPER_EMAIL: ${{ secrets.INSTAPAPER_EMAIL }}
-          INSTAPAPER_PASSWORD: ${{ secrets.INSTAPAPER_PASSWORD }}
-          INSTAPAPER_FOLDER: ${{ vars.INSTAPAPER_FOLDER || 'Tech News' }}
-        run: node scripts/sync-instapaper-bookmarks.mjs
-
-      - name: Commit and push updated bookmarks
-        run: |
-          set -euo pipefail
-          git config user.name "github-actions[bot]"
-          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
-          git add -f data/instapaper-bookmarks.json
-          git diff --cached --quiet && exit 0
-          git commit -m "chore: sync Instapaper bookmarks after new post"
-          git push
diff --git a/.github/workflows/schedule-posts.yml b/.github/workflows/schedule-posts.yml
index 1f1c52f..0490a88 100644
--- a/.github/workflows/schedule-posts.yml
+++ b/.github/workflows/schedule-posts.yml
@@ -105,29 +105,6 @@ jobs:
           URL="https://www.techtips.fun/blog/${SLUG}/"
           node scripts/add-instapaper-bookmark.mjs "$URL" "$TITLE" "New post from techtips.fun"
 
-      # Sync Instapaper bookmarks to local JSON so /read page refreshes
-      - name: Sync Instapaper bookmarks
-        if: steps.publish.outputs.slug != ''
-        env:
-          INSTAPAPER_CONSUMER_KEY: ${{ secrets.INSTAPAPER_CONSUMER_KEY }}
-          INSTAPAPER_CONSUMER_SECRET: ${{ secrets.INSTAPAPER_CONSUMER_SECRET }}
-          INSTAPAPER_EMAIL: ${{ secrets.INSTAPAPER_EMAIL }}
-          INSTAPAPER_PASSWORD: ${{ secrets.INSTAPAPER_PASSWORD }}
-          INSTAPAPER_FOLDER: ${{ vars.INSTAPAPER_FOLDER || 'Tech News' }}
-        run: node scripts/sync-instapaper-bookmarks.mjs
-
-      - name: Commit updated bookmarks
-        if: steps.publish.outputs.slug != ''
-        run: |
-          set -euo pipefail
-          git config user.name "github-actions[bot]"
-          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
-          git add -f data/instapaper-bookmarks.json data/read-queue-state.json
-          git diff --cached --quiet && exit 0
-          git commit -m "chore: sync Instapaper bookmarks after publish [skip ci]"
-          git pull --rebase origin main || true
-          git push origin HEAD:main
-
       # The publish commit above is pushed with the automatic GITHUB_TOKEN,
       # which does not trigger other workflows — so the LinkedIn teaser is
       # posted here directly instead of relying on the push event.
@@ -170,5 +147,4 @@ jobs:
       #   run: npx wrangler deploy
       #   env:
       #     CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
-      #     CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}      # Sync Instapaper bookmarks to local JSON so /read page refreshes
- 
+      #     CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
