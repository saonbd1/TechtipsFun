---
import ResponsiveImg from '../components/ResponsiveImg.astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostShare from '../components/PostShare.astro';
import PostAuthor from '../components/PostAuthor.astro';
import { toTaxonomySlug } from '../utils/taxonomy';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type Props = CollectionEntry<'blog'>['data'] & {
	socialImage?: string;
	showToc?: boolean;
	schema?: Record<string, unknown>;
	headings?: Heading[];
};

const props = Astro.props.frontmatter || Astro.props;
const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags = [],
	socialImage,
	showToc = false,
	schema,
	headings = [],
} = props;
const publishedTime = pubDate instanceof Date ? pubDate.toISOString() : undefined;
const modifiedTime = updatedDate instanceof Date ? updatedDate.toISOString() : undefined;
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			socialImage={socialImage}
			type={socialImage ? 'article' : 'website'}
			publishedTime={publishedTime}
				modifiedTime={modifiedTime}
				schema={schema}
			/>
		<style>
			main {
				width: 100%;
				max-width: 800px;
				margin: 0 auto;
			}
			article {
				width: min(100%, 760px);
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose,
			.post-content {
				width: 100%;
				max-width: none;
				box-sizing: border-box;
				margin: 0;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.taxonomy {
				align-items: center;
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				justify-content: center;
				margin-top: 0.9rem;
			}
			.taxonomy-label {
				color: rgb(var(--gray));
				font-size: 0.85rem;
				font-weight: 700;
				margin-right: 0.1rem;
				text-transform: uppercase;
			}
			.taxonomy a {
				background: rgba(var(--gray-light), 0.55);
				border-radius: 999px;
				color: rgb(var(--gray-dark));
				font-size: 0.9rem;
				padding: 0.32rem 0.65rem;
				text-decoration: none;
				transition: 0.2s ease;
			}
			.taxonomy a:hover {
				background: rgb(var(--accent));
				color: white;
			}
			.toc {
				background: rgba(var(--gray-light), 0.45);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				box-sizing: border-box;
				margin: 0 0 2.5rem;
				padding: 1rem 1.25rem 0.75rem;
			}
			.toc-title {
				color: rgb(var(--gray));
				font-size: 1rem;
				letter-spacing: 0.06em;
				margin: 0 0 0.6rem;
				text-transform: uppercase;
			}
			.toc-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.toc-item {
				line-height: 1.45;
				margin-bottom: 0.25rem;
			}
			.toc a {
				color: rgb(var(--gray-dark));
				font-size: 0.92rem;
				line-height: 1.35;
				text-decoration: none;
			}
			.toc a:hover,
			.toc a:focus-visible {
				color: rgb(var(--accent));
				text-decoration: underline;
			}
			.toc .toc-subitem {
				padding-left: 0.85rem;
			}
			.post-content :is(h2, h3) {
				scroll-margin-top: 5.5rem;
			}
			/* Keep the table of contents above the article at every viewport size. */
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <ResponsiveImg width={1020} height={510} src={heroImage} alt={title} sizes="(max-width: 840px) 100vw, 800px" priority />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{(category || tags.length > 0) && (
							<div class="taxonomy" aria-label="Post taxonomy">
								{category && <><span class="taxonomy-label">Category</span><a href={`/categories/${toTaxonomySlug(category)}/`}>{category}</a></>}
								{tags.length > 0 && <span class="taxonomy-label">Tags</span>}
								{tags.map((tag: string) => <a href={`/tags/${toTaxonomySlug(tag)}/`}>#{tag}</a>)}
							</div>
						)}
						<hr />
					</div>
				</div>
				<div class="post-content">
					{showToc && headings.length > 0 && (
						<nav class="toc" aria-labelledby="toc-heading">
							<h2 class="toc-title" id="toc-heading">On this page</h2>
							<ol class="toc-list">
								{headings.map((heading) => (
									<li class={heading.depth > 2 ? 'toc-item toc-subitem' : 'toc-item'}>
										<a href={`#${heading.slug}`}>{heading.text}</a>
									</li>
								))}
							</ol>
						</nav>
					)}
					<slot />
				</div>
					<PostShare />
					<PostAuthor />

				</article>
		</main>
		<Footer />
	</body>
</html>
