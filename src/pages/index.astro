---
import ResponsiveImg from '../components/ResponsiveImg.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { toTaxonomySlug } from '../utils/taxonomy';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featuredPost, ...remainingPosts] = posts;
const recentPosts = remainingPosts.slice(0, 4);
const popularPostIds = [
	'best-ai-tools-for-researchers-students',
	'css-grid-vs-flexbox-when-to-actually',
	'simple-tips-to-solve-your-pc-startup-and-shutdown-problems',
];
const popularPosts = popularPostIds
	.map((id) => posts.find((post) => post.id === id))
	.filter((post): post is (typeof posts)[number] => Boolean(post));
const categories = [...new Set(posts.map((post) => post.data.category))].slice(0, 6);
const siteUrl = new URL('/', Astro.site);
const homepageSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${siteUrl.href}#website`,
			url: siteUrl.href,
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			publisher: { '@id': `${siteUrl.href}#organization` },
		},
		{
			'@type': 'Organization',
			'@id': `${siteUrl.href}#organization`,
			name: SITE_TITLE,
			url: siteUrl.href,
			description: SITE_DESCRIPTION,
		},
		{
			'@type': 'WebPage',
			'@id': `${siteUrl.href}#webpage`,
			url: siteUrl.href,
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			isPartOf: { '@id': `${siteUrl.href}#website` },
			about: { '@id': `${siteUrl.href}#organization` },
		},
	],
};
	---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE}: Honest Windows, AI & Web Dev Guides`} description={SITE_DESCRIPTION} schema={homepageSchema} />
		<style>
			main { max-width: 1120px; padding: 0 1.25rem 4rem; width: 100%; }
			.intro { max-width: 720px; padding: 4.5rem 0 2.6rem; }
			.eyebrow { color: rgb(var(--accent)); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.12em; margin: 0 0 0.8rem; text-transform: uppercase; }
			.intro h1 { color: rgb(var(--black)); font-size: clamp(2.1rem, 4.7vw, 3.75rem); letter-spacing: -0.06em; line-height: 1; margin: 0; max-width: 760px; }
			.intro p:last-child { color: rgb(var(--gray)); font-size: 1.14rem; line-height: 1.65; margin: 1.25rem 0 0; max-width: 650px; }
			.section-heading { align-items: end; display: flex; gap: 1rem; justify-content: space-between; margin: 0 0 1.1rem; }
			.section-title { color: rgb(var(--black)); font-size: clamp(1.45rem, 2.6vw, 1.95rem); font-weight: 700; line-height: 1.2; margin: 0; }
			.section-heading a { color: rgb(var(--accent)); font-weight: 700; text-decoration: none; }
			.section-heading a:hover { text-decoration: underline; }
			.featured { align-items: stretch; background: rgb(var(--gray-light)); border-radius: 22px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); margin-bottom: 4rem; overflow: hidden; }
			.featured-image { align-items: center; display: flex; min-width: 0; overflow: hidden; }
			.featured-image img { display: block; height: auto; max-width: 100%; object-fit: contain; transition: transform 0.35s var(--ease-out, ease-out); width: 100%; }
			.featured:hover .featured-image img { transform: scale(1.025); }
			.featured-content { align-content: center; display: grid; padding: clamp(1.75rem, 4vw, 3.5rem); }
			.featured-content h2 { font-size: clamp(1.75rem, 3.1vw, 2.85rem); letter-spacing: -0.045em; line-height: 1.06; margin: 0.75rem 0; }
			.featured-content h2 a { color: rgb(var(--black)); text-decoration: none; }
			.featured-content h2 a:hover { color: rgb(var(--accent)); }
			.description { color: rgb(var(--gray-dark)); line-height: 1.6; margin: 0 0 1.25rem; }
			.meta { color: rgb(var(--gray)); font-size: 0.92rem; margin: 0 0 1.25rem; }
			.category, .tag { border-radius: 999px; display: inline-block; font-size: 0.82rem; font-weight: 750; line-height: 1; padding: 0.45rem 0.65rem; text-decoration: none; }
			.category { background: rgba(var(--accent), 0.1); color: rgb(var(--accent)); }
			.category:hover { background: rgb(var(--accent)); color: white; }
			.button { align-items: center; background: rgb(var(--black)); border-radius: 999px; color: white; display: inline-flex; font-weight: 750; justify-content: center; padding: 0.72rem 1rem; text-decoration: none; width: fit-content; }
			.button:hover { background: rgb(var(--accent)); transform: translateY(-1px); }
			.recent-section { margin-top: 1rem; }
			.post-grid { display: grid; gap: 1.4rem; grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
			.post-grid > li { display: flex; }
				.post-card { display: grid; grid-template-rows: auto 1fr; height: 100%; width: 100%; }
			.post-card-image { display: block; overflow: hidden; }
			.post-card-image img { aspect-ratio: 16 / 9; border-radius: 12px; display: block; object-fit: cover; transition: transform 0.3s var(--ease-out, ease-out); width: 100%; }
			.post-card:hover .post-card-image img { transform: scale(1.035); }
			.post-card-body { display: flex; flex-direction: column; min-height: 12.1rem; padding-top: 0.85rem; }
.post-card-meta { align-items: center; display: flex; flex-wrap: nowrap; gap: 0.45rem; padding-top: 0.85rem; white-space: nowrap; }
				.post-card-meta .meta { color: rgb(var(--gray)); flex: 0 0 auto; font-size: 0.78rem; margin: 0; }
				.post-card-meta .category { flex: 0 0 auto; font-size: 0.68rem; padding: 0.34rem 0.46rem; }
				.post-card h3 { font-size: 1.08rem; letter-spacing: -0.02em; line-height: 1.25; margin: 0.75rem 0 0; }
				.post-card h3 a { color: rgb(var(--black)); text-decoration: none; }
				.post-card h3 a:hover { color: rgb(var(--accent)); }
			.tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; padding-top: 1.55rem; }
			.tag { background: rgba(var(--gray-light), 0.7); color: rgb(var(--gray-dark)); font-weight: 600; }
			.tag:hover { background: rgb(var(--accent)); color: white; }
				.popular-section { margin-top: 4.5rem; padding: clamp(1.5rem, 3vw, 2.4rem); border: 1px solid rgba(var(--accent), 0.12); border-radius: 20px; background: linear-gradient(135deg, rgba(var(--accent), 0.075), rgba(var(--gray-light), 0.56)); }
				.popular-section .section-heading { margin-bottom: 0.55rem; }
				.popular-intro { color: rgb(var(--gray)); line-height: 1.55; margin: 0 0 1.4rem; max-width: 620px; }
				.popular-grid { display: grid; gap: 1rem; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
				.popular-card { height: 100%; overflow: hidden; border: 1px solid rgba(var(--gray), 0.16); border-radius: 14px; background: white; box-shadow: 0 8px 20px rgba(30, 35, 80, 0.06); }
				.popular-card-image { display: block; position: relative; }
				.popular-card-image img { aspect-ratio: 16 / 8.7; display: block; object-fit: cover; transition: transform 0.3s var(--ease-out, ease-out); width: 100%; }
				.popular-card:hover .popular-card-image img { transform: scale(1.035); }
				.popular-rank { align-items: center; background: rgb(var(--accent)); border: 2px solid white; border-radius: 50%; color: white; display: inline-flex; font-size: 0.75rem; font-weight: 800; height: 2rem; justify-content: center; position: absolute; right: 0.65rem; top: 0.65rem; width: 2rem; }
.popular-card-body { display: flex; flex-direction: column; min-height: 195px; padding: 1rem; }
					.popular-card-meta { align-items: center; display: flex; flex-wrap: nowrap; gap: 0.45rem; white-space: nowrap; }
					.popular-card-meta .meta { color: rgb(var(--gray)); flex: 0 0 auto; font-size: 0.78rem; margin: 0; }
					.popular-card-meta .category { flex: 0 0 auto; font-size: 0.68rem; padding: 0.34rem 0.46rem; }
					.popular-card h3 { font-size: 1.08rem; letter-spacing: -0.025em; line-height: 1.28; margin: 0.75rem 0 0; }
				.popular-card h3 a { color: rgb(var(--black)); text-decoration: none; }
				.popular-card h3 a:hover { color: rgb(var(--accent)); }
				.popular-card .description { font-size: 0.92rem; line-height: 1.5; margin: 0.7rem 0 0; }
				.topic-strip { align-items: center; border-top: 1px solid rgb(var(--gray-light)); display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 4rem; padding-top: 2rem; }
			.topic-strip strong { color: rgb(var(--gray-dark)); margin-right: 0.2rem; }
			.topic-strip a { color: rgb(var(--gray-dark)); font-size: 0.92rem; font-weight: 700; text-decoration: none; }
			.topic-strip a:hover { color: rgb(var(--accent)); text-decoration: underline; }
				@media (max-width: 900px) { .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .popular-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
			@media (max-width: 720px) {
				main { padding: 0 1rem 3rem; }
				.intro { padding: 3rem 0 2rem; }
				.featured { grid-template-columns: 1fr; margin-bottom: 3rem; }
				.featured-image { align-self: start; min-height: 0; }
				.featured-content { padding: 1.5rem; }
					.post-grid { gap: 2rem 1rem; }
					.post-card-body { min-height: 0; }
					.popular-section { margin-top: 3.25rem; padding: 1.25rem; }
					.popular-grid { grid-template-columns: 1fr; }
					.popular-card-body { min-height: 0; }
				}
				@media (max-width: 430px) { .post-grid { grid-template-columns: 1fr; } .section-heading { align-items: start; flex-direction: column; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro" aria-labelledby="homepage-title">
				<p class="eyebrow">Practical technology, clearly explained</p>
				<h1 id="homepage-title">Real tech. Useful lessons. No noise.</h1>
				<p>Read practical guides on AI tools, local computing, web development, privacy, and the everyday systems that keep your technology working.</p>
			</section>

			{featuredPost && (
<section aria-labelledby="latest-post-heading">
						<div class="section-heading">
							<p id="latest-post-heading" class="section-title">Latest from the blog</p>
						<a href="/blog/">View all posts</a>
					</div>
					<article class="featured">
						<a class="featured-image" href={`/blog/${featuredPost.id}/`}>
							<ResponsiveImg src={featuredPost.data.heroImage ?? '/blog-placeholder-1.webp'} alt={featuredPost.data.title} width="960" height="540" sizes="(max-width: 720px) 100vw, 560px" priority />
						</a>
						<div class="featured-content">
							<a class="category" href={`/categories/${toTaxonomySlug(featuredPost.data.category)}/`}>{featuredPost.data.category}</a>
							<h2><a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a></h2>
							<p class="meta"><FormattedDate date={featuredPost.data.pubDate} /></p>
							<p class="description">{featuredPost.data.description}</p>
							<a class="button" href={`/blog/${featuredPost.id}/`}>Read the latest post <span aria-hidden="true">→</span></a>
						</div>
					</article>
				</section>
			)}

				{recentPosts.length > 0 && (
<section class="recent-section" aria-labelledby="recent-posts-heading">
						<div class="section-heading">
							<p id="recent-posts-heading" class="section-title">More recent posts</p>
						<a href="/tags/">Browse tags</a>
					</div>
					<ul class="post-grid">
						{recentPosts.map((post) => (
							<li>
								<article class="post-card">
									<a class="post-card-image" href={`/blog/${post.id}/`}>
										<ResponsiveImg src={post.data.heroImage ?? '/blog-placeholder-1.webp'} alt={post.data.title} width="640" height="360" sizes="(max-width: 430px) 100vw, (max-width: 900px) 50vw, 300px" />
									</a>
										<div class="post-card-body">
											<div class="post-card-meta">
												<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
												<a class="category" href={`/categories/${toTaxonomySlug(post.data.category)}/`}>{post.data.category}</a>
											</div>
											<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
										<div class="tags" aria-label="Post tags">
											{post.data.tags.slice(0, 2).map((tag) => <a class="tag" href={`/tags/${toTaxonomySlug(tag)}/`}>#{tag}</a>)}
										</div>
									</div>
								</article>
							</li>
						))}
					</ul>
				</section>
			)}

				{popularPosts.length > 0 && (
<section class="popular-section" aria-labelledby="popular-posts-heading">
							<div class="section-heading">
								<p id="popular-posts-heading" class="section-title">Most popular posts</p>
							<a href="/blog/">Browse all posts</a>
						</div>
						<p class="popular-intro">A hand-picked starting point for practical, evergreen technology guides.</p>
						<ol class="popular-grid">
							{popularPosts.map((post, index) => (
								<li>
									<article class="popular-card">
										<a class="popular-card-image" href={`/blog/${post.id}/`}>
											<ResponsiveImg src={post.data.heroImage ?? '/blog-placeholder-1.webp'} alt={post.data.title} width="640" height="348" sizes="(max-width: 720px) 100vw, 380px" />
											<span class="popular-rank" aria-label={`Popular post number ${index + 1}`}>{String(index + 1).padStart(2, '0')}</span>
										</a>
											<div class="popular-card-body">
												<div class="popular-card-meta">
													<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
													<a class="category" href={`/categories/${toTaxonomySlug(post.data.category)}/`}>{post.data.category}</a>
												</div>
												<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
											<p class="description">{post.data.description}</p>
										</div>
									</article>
								</li>
							))}
						</ol>
					</section>
				)}

				<nav class="topic-strip" aria-label="Browse categories">
				<strong>Explore by topic:</strong>
				{categories.map((category) => <a href={`/categories/${toTaxonomySlug(category)}/`}>{category}</a>)}
				<a href="/categories/">All categories →</a>
			</nav>
		</main>
		<Footer />
	</body>
</html>
