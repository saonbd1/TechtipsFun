From 0000000000000000000000000000000000000003 Mon Sep 17 00:00:00 2001
From: Saon Islam <saonbd33@gmail.com>
Date: Tue, 3 Nov 2026 09:35:00 +0000
Subject: [PATCH] ci!: delete the Instapaper workflows and their schedule-posts steps

The /read page and the Instapaper integration were removed in 79fdaa5. This
is the workflow half, which the App token here cannot push:

- deletes .github/workflows/daily-read-link.yml
- deletes .github/workflows/instapaper-on-publish.yml
- strips the three Instapaper steps from schedule-posts.yml (add bookmark,
  sync bookmarks, commit bookmarks) — they call scripts that no longer
  exist, and drops a stray comment fragment from its last line

Apply, commit, push, then delete this file. If you would rather not keep
schedule-posts.yml at all, delete that file instead of applying its hunk.
---
diff --git a/.github/workflows/daily-read-link.yml b/.github/workflows/daily-read-link.yml
deleted file mode 100644
index 1373719..0000000
--- a/.github/workflows/daily-read-link.yml
+++ /dev/null
@@ -1,59 +0,0 @@
-name: Daily read link
-
-# Every day at 09:00 UTC, pick the next unposted link from data/read-queue.json,
-# add it to your Instapaper "Tech News" folder, then sync that folder's bookmarks
-# into data/instapaper-bookmarks.json so the /read page on techtips.fun refreshes.
-#
-# The folder is configurable with the repository variable INSTAPAPER_FOLDER
-# (Settings → Secrets and variables → Actions → Variables). Default: "Tech News".
-#
-# Important: never put "[skip ci]" in the sync commit message below. Cloudflare
-# Workers Builds skips those commits, so /read would never rebuild.
-
-on:
-  schedule:
-    - cron: "0 9 * * *"
-  workflow_dispatch:
-
-permissions:
-  contents: write
-
-jobs:
-  daily-link:
-    runs-on: ubuntu-latest
-    steps:
-      - name: Check out repository
-        uses: actions/checkout@v4
-
-      - name: Set up Node.js
-        uses: actions/setup-node@v4
-        with:
-          node-version: 22
-
-      - name: Add next link from read queue to Instapaper
-        env:
-          INSTAPAPER_CONSUMER_KEY: ${{ secrets.INSTAPAPER_CONSUMER_KEY }}
-          INSTAPAPER_CONSUMER_SECRET: ${{ secrets.INSTAPAPER_CONSUMER_SECRET }}
-          INSTAPAPER_EMAIL: ${{ secrets.INSTAPAPER_EMAIL }}
-          INSTAPAPER_PASSWORD: ${{ secrets.INSTAPAPER_PASSWORD }}
-          INSTAPAPER_FOLDER: ${{ vars.INSTAPAPER_FOLDER || 'Tech News' }}
-        run: node scripts/daily-read-link.mjs
-
-      - name: Sync Instapaper bookmarks to local JSON
-        env:
-          INSTAPAPER_CONSUMER_KEY: ${{ secrets.INSTAPAPER_CONSUMER_KEY }}
-          INSTAPAPER_CONSUMER_SECRET: ${{ secrets.INSTAPAPER_CONSUMER_SECRET }}
-          INSTAPAPER_EMAIL: ${{ secrets.INSTAPAPER_EMAIL }}
-          INSTAPAPER_PASSWORD: ${{ secrets.INSTAPAPER_PASSWORD }}
-          INSTAPAPER_FOLDER: ${{ vars.INSTAPAPER_FOLDER || 'Tech News' }}
-        run: node scripts/sync-instapaper-bookmarks.mjs
-
-      - name: Commit and push updated bookmarks
-        run: |
-          set -euo pipefail
-          git config user.name "github-actions[bot]"
-          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
-          git add -f data/instapaper-bookmarks.json data/read-queue-state.json
-          git diff --cached --quiet && exit 0
-          git commit -m "chore: sync Instapaper bookmarks"
-          git push
diff --git a/.github/workflows/instapaper-on-publish.yml b/.github/workflows/instapaper-on-publish.yml
deleted file mode 100644
index d4271fc..0000000
--- a/.github/workflows/instapaper-on-publish.yml
+++ /dev/null
@@ -1,102 +0,0 @@
-name: Add new posts to Instapaper
-
-# When a new blog post is published (pushed to src/content/blog/), add it to your
-# Instapaper folder and sync that folder's bookmarks to data/instapaper-bookmarks.json
-# so the /read page refreshes on the next build.
-#
-# Important: never put "[skip ci]" in the sync commit message below. Cloudflare
-# Workers Builds skips those commits, so /read would never rebuild.
-
-on:
-  push:
-    branches: [main]
-    paths:
-      - 'src/content/blog/**'
-  workflow_dispatch:
-    inputs:
-      slug:
-        description: Post slug to add (filename without .md/.mdx)
-        required: false
-
-permissions:
-  contents: write
-
-jobs:
-  add-to-instapaper:
-    runs-on: ubuntu-latest
-    steps:
-      - name: Check out repository
-        uses: actions/checkout@v4
-        with:
-          fetch-depth: 2
-
-      - name: Set up Node.js
-        uses: actions/setup-node@v4
-        with:
-          node-version: 22
-
-      - name: Detect newly added posts
-        id: posts
-        run: |
-          set -euo pipefail
-          if [ -n "${{ github.event.inputs.slug }}" ]; then
-            echo "slugs=${{ github.event.inputs.slug }}" >> "$GITHUB_OUTPUT"
-            exit 0
-          fi
-          BEFORE="${{ github.event.before }}"
-          ALL_ZERO="0000000000000000000000000000000000000000"
-          if [ "$BEFORE" = "$ALL_ZERO" ]; then
-            echo "Initial push; skipping automatic add."
-            echo "slugs=" >> "$GITHUB_OUTPUT"
-            exit 0
-          fi
-          FILES=$(git diff --name-only --diff-filter=A "$BEFORE" "${{ github.event.sha }}" -- src/content/blog/ | grep -E '\.(md|mdx)$' || true)
-          if [ -z "$FILES" ]; then
-            echo "No newly added posts."
-            echo "slugs=" >> "$GITHUB_OUTPUT"
-            exit 0
-          fi
-          SLUGS=$(echo "$FILES" | sed -E 's#.*/##; s/\.(md|mdx)$//' | paste -sd,)
-          echo "New posts: $SLUGS"
-          echo "slugs=$SLUGS" >> "$GITHUB_OUTPUT"
-
-      - name: Add each new post to Instapaper
-        if: steps.posts.outputs.slugs != ''
-        env:
-          INSTAPAPER_CONSUMER_KEY: ${{ secrets.INSTAPAPER_CONSUMER_KEY }}
-          INSTAPAPER_CONSUMER_SECRET: ${{ secrets.INSTAPAPER_CONSUMER_SECRET }}
-          INSTAPAPER_EMAIL: ${{ secrets.INSTAPAPER_EMAIL }}
-          INSTAPAPER_PASSWORD: ${{ secrets.INSTAPAPER_PASSWORD }}
-          INSTAPAPER_FOLDER: ${{ vars.INSTAPAPER_FOLDER || 'Tech News' }}
-          SITE_URL: https://www.techtips.fun
-        run: |
-          set -euo pipefail
-          IFS=',' read -ra SLUGS <<< "${{ steps.posts.outputs.slugs }}"
-          for slug in "${SLUGS[@]}"; do
-            echo "Adding $slug to Instapaper..."
-            # Read title from the post's frontmatter
-            FILE="src/content/blog/${slug}.md"
-            if [ ! -f "$FILE" ]; then FILE="src/content/blog/${slug}.mdx"; fi
-            TITLE=$(sed -n 's/^title: *["'"'"']\(.*\)["'"'"'] *$/\1/p' "$FILE" | head -1)
-            URL="${SITE_URL}/blog/${slug}/"
-            node scripts/add-instapaper-bookmark.mjs "$URL" "$TITLE" "New post from techtips.fun"
-          done
-
-      - name: Sync Instapaper bookmarks to local JSON
-        env:
-          INSTAPAPER_CONSUMER_KEY: ${{ secrets.INSTAPAPER_CONSUMER_KEY }}
-          INSTAPAPER_CONSUMER_SECRET: ${{ secrets.INSTAPAPER_CONSUMER_SECRET }}
-          INSTAPAPER_EMAIL: ${{ secrets.INSTAPAPER_EMAIL }}
-          INSTAPAPER_PASSWORD: ${{ secrets.INSTAPAPER_PASSWORD }}
-          INSTAPAPER_FOLDER: ${{ vars.INSTAPAPER_FOLDER || 'Tech News' }}
-        run: node scripts/sync-instapaper-bookmarks.mjs
-
-      - name: Commit and push updated bookmarks
-        run: |
-          set -euo pipefail
-          git config user.name "github-actions[bot]"
-          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
-          git add -f data/instapaper-bookmarks.json
-          git diff --cached --quiet && exit 0
-          git commit -m "chore: sync Instapaper bookmarks after new post"
-          git push
