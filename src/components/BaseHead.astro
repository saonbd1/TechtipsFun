---
// Import the global.css file here so that it is included on
// all pages through the <BaseHead /> component.
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	socialImage?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;	
	noindex?: boolean;
	schema?: Record<string, unknown>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = '/blog-placeholder-1.webp',
	socialImage,
	type = 'website',
	publishedTime,
	modifiedTime,
	noindex = false,
	schema,
} = Astro.props;
const DEFAULT_SOCIAL_IMAGE = '/og/default.png';
const IMAGE_TYPES: Record<string, string> = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', webp: 'image/webp' };
const imageURL = new URL(socialImage ?? (Astro.props.image ? image : DEFAULT_SOCIAL_IMAGE), Astro.site ?? Astro.url);
const imageType = IMAGE_TYPES[imageURL.pathname.split('.').pop()?.toLowerCase() ?? ''] ?? 'image/png';
const usesCardSize = imageURL.pathname.startsWith('/og/');
const articleImageURL = new URL(image, Astro.site ?? Astro.url);
const siteURL = new URL('/', Astro.site ?? Astro.url);
const authorURL = new URL('/about/', Astro.site ?? Astro.url);
const articleSchema =
	type === 'article' && publishedTime
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				'@id': `${canonicalURL.href}#blogposting`,
				mainEntityOfPage: {
					'@type': 'WebPage',
					'@id': canonicalURL.href,
				},
				headline: title,
				description,
				image: [articleImageURL.href],
				datePublished: publishedTime,
				dateModified: modifiedTime ?? publishedTime,
				author: {
					'@type': 'Person',
					name: 'SaonBD',
					url: authorURL.href,
				},
				publisher: {
					'@type': 'Organization',
					'@id': `${siteURL.href}#organization`,
					name: 'Techtips.fun',
					url: siteURL.href,
				},
				inLanguage: 'en',
				isAccessibleForFree: true,
			}
		: undefined;
---

<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-3DN174LW99"></script>
<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag(){dataLayer.push(arguments);}
	gtag('js', new Date());
	gtag('config', 'G-3DN174LW99');
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/space-grotesk-latin-variable.woff2" as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" type="application/rss+xml" title="Tech Tips in Fun RSS Feed" href="/rss.xml" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content="Tech Tips in Fun" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:secure_url" content={imageURL} />
<meta property="og:image:type" content={imageType} />
{usesCardSize && <meta property="og:image:width" content="1200" />}
{usesCardSize && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={`${title} social sharing card`} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{type === 'article' && <meta property="article:author" content="SaonBD" />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@ayenaldewan" />
<meta name="twitter:creator" content="@ayenaldewan" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={`${title} social sharing card`} />
	{(schema || articleSchema) && (
		<script type="application/ld+json" set:html={JSON.stringify(schema ?? articleSchema)} />
	)}
