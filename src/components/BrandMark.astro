---
/**
 * BrandMark — the TechTips.fun logo mark (rocket/arrow "A").
 *
 * Recreated as a vector so it stays crisp at any size and can be recoloured.
 * The mark is drawn with `currentColor`, so it inherits whatever colour the
 * surrounding context sets (see `.brand-mark` in Header.astro). The original
 * artwork is brand navy (#1b3a6e) — on the dark header it is recoloured to
 * white so it reads clearly next to the wordmark, and the light-mode favicon
 * keeps the navy.
 *
 * The default size lives in this component's own scoped style on purpose: the
 * `svg` is the component root, so a parent component cannot size it with a
 * plain descendant selector (Astro scopes that selector to the parent and the
 * mark would keep its default size instead). Parents override the size with
 * `:global(svg)`.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 100 124"
	width="100"
	height="124"
	role="img"
	aria-hidden="true"
	focusable="false"
>
	<g fill="currentColor">
		<!-- sail / nose blade -->
		<path d="M41 0 L70 70 L2 80 Z" />
		<!-- right fin -->
		<path d="M56 50 L68 42 L99 104 L86 114 Z" />
		<!-- swoosh ribbon -->
		<path d="M4 94 C 26 80 50 58 88 38 L 92 50 C 60 70 34 88 4 94 Z" />
		<!-- arrow head -->
		<path d="M99 22 L95 50 L84 38 L72 26 Z" />
		<!-- exhaust chevron -->
		<path d="M46 90 L53 102 L60 90 L66 95 L53 120 L40 95 Z" />
	</g>
</svg>

<style>
	/* Aspect ratio is 100 x 124, so the width is derived from the height. */
	svg {
		display: block;
		height: 1.85rem;
		width: calc(1.85rem * 100 / 124);
	}
</style>

