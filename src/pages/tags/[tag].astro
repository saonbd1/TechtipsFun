---
import ResponsiveImg from '../../components/ResponsiveImg.astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';
import { toTaxonomySlug } from '../../utils/taxonomy';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

	return tags.map((tag) => ({
		params: { tag: toTaxonomySlug(tag) },
		props: { tag },
	}));
}

const { tag } = Astro.props as { tag: string };
const posts = (await getCollection('blog'))
	.filter((post) => post.data.tags.includes(tag))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Posts tagged ${tag}`} description={`Explore TechTips.fun posts tagged ${tag}, with practical tutorials and technology insights.`} noindex />
		<style>
			main { width: 960px; }
			header { margin-bottom: 2rem; text-align: center; }
			h1 { margin-bottom: 0.4rem; }
			.intro { color: rgb(var(--gray)); }
			.post-list { display: grid; gap: 1rem; list-style: none; margin: 0; padding: 0; }
			.post-list a { align-items: center; color: inherit; display: grid; gap: 1.25rem; grid-template-columns: 180px 1fr; text-decoration: none; }
			.post-list li { border-bottom: 1px solid rgb(var(--gray-light)); padding-bottom: 1rem; }
			.post-list img { aspect-ratio: 16 / 9; border-radius: 10px; object-fit: cover; width: 100%; }
			.title { color: rgb(var(--black)); margin: 0 0 0.45rem; }
			.date, .description { color: rgb(var(--gray)); margin: 0; }
			.description { margin-top: 0.45rem; }
			.post-list a:hover .title { color: rgb(var(--accent)); }
			@media (max-width: 720px) { .post-list a { grid-template-columns: 1fr; gap: 0.65rem; } .post-list img { max-width: 100%; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header>
				<p class="intro">Tag</p>
				<h1>#{tag}</h1>
				<p class="intro">{posts.length} {posts.length === 1 ? 'post' : 'posts'} with this tag.</p>
			</header>
			<ul class="post-list">
				{posts.map((post: CollectionEntry<'blog'>) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<ResponsiveImg src={post.data.heroImage ?? '/blog-placeholder-1.webp'} alt={post.data.title} width="360" height="203" sizes="(max-width: 720px) 100vw, 360px" />
							<div>
								<h2 class="title">{post.data.title}</h2>
								<p class="date"><FormattedDate date={post.data.pubDate} /></p>
								<p class="description">{post.data.description}</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
