{
  "name": "astro-blog-starter-template",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/admin", "/admin/*"]
  },
  "routes": [
    {
      "pattern": "techtips.fun/*",
      "zone_id": "7c53d51c78a988e2c4fd381738899f61"
    },
    {
      "pattern": "www.techtips.fun/*",
      "zone_id": "7c53d51c78a988e2c4fd381738899f61"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": false,
  "vars": {
    "ADMIN_REPO": "saonbd1/TechtipsFun"
  }
}
