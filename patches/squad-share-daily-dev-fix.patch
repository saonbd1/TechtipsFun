+name: Post new article to Squad via Slack
+# Posts every newly added post under src/content/blog/ to the Slack channel that
+# is connected to your daily.dev Squad.
+#
+# Required repository secret: SLACK_WEBHOOK_URL
+#   Settings -> Secrets and variables -> Actions -> New repository secret
+#   Value: the Slack incoming-webhook URL for the Squad channel
+#          (Slack -> Your app -> Incoming Webhooks -> copy the webhook URL)
+#   The step below fails with a clear message when it is missing, instead of
+#   failing later inside curl with "URL rejected".
+on:
+  push:
+    branches: [main]
+    paths: ['src/content/blog/**']
+jobs:
+  notify:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with: { fetch-depth: 2 }
+
+      - name: Find new posts
+        id: posts
+        run: |
+          FILES=$(git diff --name-only --diff-filter=A HEAD~1 HEAD -- 'src/content/blog/**' || true)
+          {
+            echo 'files<<EOF'
+            echo "$FILES"
+            echo 'EOF'
+          } >> "$GITHUB_OUTPUT"
+          echo "$FILES"
+
+      - name: Post to Slack (daily.dev Squad)
+        if: steps.posts.outputs.files != ''
+        env:
+          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
+          SITE: https://www.techtips.fun
+          FILES: ${{ steps.posts.outputs.files }}
+        run: |
+          if [ -z "$SLACK_WEBHOOK_URL" ]; then
+            echo "::error::SLACK_WEBHOOK_URL is not set. Add the Slack incoming-webhook URL for your daily.dev Squad channel under Settings -> Secrets and variables -> Actions, then re-run this workflow."
+            exit 1
+          fi
+
+          while IFS= read -r f; do
+            [ -n "$f" ] || continue
+
+            # Astro's content-collection entry id, which is what the post URL and
+            # its social card both use. Mirrors src/utils/post-slug.mjs:
+            # lowercase, drop everything outside [a-z0-9 _-], spaces to dashes.
+            # Deriving the slug from the raw filename would link to a 404 for
+            # files like "Simple-Ghostty-…" or "update-tpm- …(1).md".
+            slug=$(basename "$f" \
+              | sed -E 's/\.(md|mdx)$//I' \
+              | tr '[:upper:]' '[:lower:]' \
+              | sed -E 's/[^a-z0-9 _-]//g; s/ /-/g')
+            # Trim the frontmatter value, then the surrounding quotes. The
+            # trailing-whitespace strip matters for CRLF files, where the \r sits
+            # after the closing quote and would otherwise keep it in the title.
+            title=$(grep -m1 '^title:' "$f" | sed -E 's/^title:[[:space:]]*//; s/[[:space:]]+$//')
+            title=${title#\"}; title=${title%\"}
+            title=${title#\'}; title=${title%\'}
+            url="$SITE/blog/$slug/"
+            text="🚀 New on Tech Tips in Fun: $title — $url"
+
+            # jq builds the payload so a title containing quotes cannot break it.
+            jq -n --arg text "$text" '{text: $text}' \
+              | curl --silent --show-error --fail-with-body \
+                  -X POST -H 'Content-type: application/json' \
+                  --data @- "$SLACK_WEBHOOK_URL"
+            echo "Posted: $url"
+          done <<< "$FILES"
