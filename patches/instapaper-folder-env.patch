From 4591396000000000000000000000000000000000a Mon Sep 17 00:00:00 2001
From: Saon Islam <saonbd33@gmail.com>
Date: Tue, 3 Nov 2026 08:55:00 +0000
Subject: [PATCH] ci(instapaper): finish wiring INSTAPAPER_FOLDER into every add/sync step

daily-read-link's add step is the last one without INSTAPAPER_FOLDER, so
setting the repository variable would move the sync but not the daily add
(the script would still fall back to its built-in "Tech News"). Also drops
the two stray blank lines inside the env blocks.

The App token here still lacks the `workflows` permission, so this stays a
patch (see patches/PATCHES-README.md).
---
 .github/workflows/daily-read-link.yml       | 2 +-
 .github/workflows/instapaper-on-publish.yml | 1 -
 2 files changed, 1 insertion(+), 2 deletions(-)

diff --git a/.github/workflows/daily-read-link.yml b/.github/workflows/daily-read-link.yml
index 3376399..a360167 100644
--- a/.github/workflows/daily-read-link.yml
+++ b/.github/workflows/daily-read-link.yml
@@ -30,6 +30,7 @@ jobs:
           INSTAPAPER_CONSUMER_SECRET: ${{ secrets.INSTAPAPER_CONSUMER_SECRET }}
           INSTAPAPER_EMAIL: ${{ secrets.INSTAPAPER_EMAIL }}
           INSTAPAPER_PASSWORD: ${{ secrets.INSTAPAPER_PASSWORD }}
+          INSTAPAPER_FOLDER: ${{ vars.INSTAPAPER_FOLDER || 'Tech News' }}
         run: node scripts/daily-read-link.mjs
 
       - name: Sync Instapaper bookmarks to local JSON
@@ -39,7 +40,6 @@ jobs:
           INSTAPAPER_EMAIL: ${{ secrets.INSTAPAPER_EMAIL }}
           INSTAPAPER_PASSWORD: ${{ secrets.INSTAPAPER_PASSWORD }}
           INSTAPAPER_FOLDER: ${{ vars.INSTAPAPER_FOLDER || 'Tech News' }}
-
         run: node scripts/sync-instapaper-bookmarks.mjs
 
       - name: Commit and push updated bookmarks
diff --git a/.github/workflows/instapaper-on-publish.yml b/.github/workflows/instapaper-on-publish.yml
index 5121faf..ac84df9 100644
--- a/.github/workflows/instapaper-on-publish.yml
+++ b/.github/workflows/instapaper-on-publish.yml
@@ -65,7 +65,6 @@ jobs:
           INSTAPAPER_EMAIL: ${{ secrets.INSTAPAPER_EMAIL }}
           INSTAPAPER_PASSWORD: ${{ secrets.INSTAPAPER_PASSWORD }}
           INSTAPAPER_FOLDER: ${{ vars.INSTAPAPER_FOLDER || 'Tech News' }}
-
           SITE_URL: https://www.techtips.fun
         run: |
           set -euo pipefail
