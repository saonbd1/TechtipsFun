---
import HeaderLink from './HeaderLink.astro';
import BrandMark from './BrandMark.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import { toTaxonomySlug } from '../utils/taxonomy';

const categories = [...new Set((await getCollection('blog')).map((post) => post.data.category))].sort(
	(a, b) => a.localeCompare(b),
);
const isBlogActive =
	Astro.url.pathname.startsWith('/blog') || Astro.url.pathname.startsWith('/categories');
---

<header class="site-header">
	<nav aria-label="Primary navigation">
			<div class="brand-wrapper">
				<a class="brand" href="/">
				<span class="brand-mark" aria-hidden="true">
					<BrandMark />
				</span>
				<span class="brand-name"><span class="brand-name__tech">Tech</span><span class="brand-name__tips">tips</span><span class="brand-name__dot">.fun</span></span>
			</a>
			</div>

			<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
\t\t\t<HeaderLink href="/read/">Read</HeaderLink>
			<details class:list={[{ 'category-dropdown': true, active: isBlogActive }]}>
				<summary aria-label="Open blog navigation">
					<span class="blog-label">Blog</span>
					<svg class="mobile-menu-icon" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" />
					</svg>
				</summary>
				<div class="category-dropdown__menu">
					<a href="/blog/">All posts</a>
					<p class="category-dropdown__label">Categories</p>
					{
						categories.map((category) => (
							<a href={`/categories/${toTaxonomySlug(category)}/`}>{category}</a>
						))
					}
				</div>
			</details>
		</div>

		<div class="social-links">
<a href="https://www.facebook.com/saon.islam.bd" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Follow SaonBD on Facebook</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"><path fill="currentColor" d="M16 8.05C16 3.6 12.42 0 8 0S0 3.6 0 8.05c0 4.02 2.93 7.35 6.75 7.95v-5.63H4.72V8.05h2.03V6.28c0-2.02 1.19-3.13 3.02-3.13.88 0 1.8.16 1.8.16v1.98h-1.01c-1 0-1.31.62-1.31 1.26v1.5h2.23l-.36 2.32H9.25V16C13.07 15.4 16 12.07 16 8.05z"></path></svg>
			</a>
			<a href="https://twitter.com/ayenaldewan" target="_blank">
				<span class="sr-only">Follow Me on Twitter</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"><path fill="currentColor" d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"></path></svg>
			</a>
			<a href="https://github.com/saonbd1/astro-blog-starter-template/" target="_blank">
				<span class="sr-only">Go to Tech tips in Fun GitHub repo</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		margin: 0;
		padding: 0 1em;
		background:
			radial-gradient(circle at 50% -220%, rgba(104, 112, 246, 0.6), transparent 52%),
			linear-gradient(115deg, #101421, #1b2040);
		box-shadow: 0 4px 16px rgba(12, 16, 32, 20%);
	}
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		min-height: 4rem;
		gap: 0.75rem;
	}
			.brand-wrapper {
				grid-column: 2;
		margin: 0;
		font-size: 1.15rem;
		letter-spacing: -0.02em;
		white-space: nowrap;
	}
	.brand {
		align-items: center;
		border-bottom: 0;
		display: inline-flex;
		gap: 0.45rem;
		padding: 0.4rem 0.3rem;
		text-decoration: none;
	}
	.brand-mark {
		display: inline-flex;
		flex: 0 0 auto;
		line-height: 0;
		/* The artwork is brand navy; on the dark header it is recoloured to white
		   (the same colour as the "Tech" wordmark) so the mark reads clearly. */
		color: #fff;
	}
	/* `:global` is required here: the mark is its own component, so a plain
	   `svg` descendant selector would be scoped to this component and never
	   match. Aspect ratio of the mark is 100 x 124. */
	.brand-mark :global(svg) {
		display: block;
		height: 1.85rem;
		width: calc(1.85rem * 100 / 124);
	}
	.brand-name {
		display: inline-block;
		color: white;
		font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;
		font-size: 1.35rem;
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.brand-name__tips,
	.brand-name__dot {
		color: #bfc4ff;
	}
	.brand-name__dot {
		font-size: 0.74em;
	}
	.internal-links {
		display: flex;
		align-items: center;
		grid-column: 1;
		grid-row: 1;
		justify-self: start;
		gap: 0.1rem;
	}
	.social-links {
		display: flex;
		grid-column: 3;
		grid-row: 1;
		justify-self: end;
	}
	nav a {
		padding: 1em 0.5em;
		border-bottom: 4px solid transparent;
		color: #e9eaff;
		text-decoration: none;
	}
	nav a.active {
		border-bottom-color: #bfc4ff;
		text-decoration: none;
	}
	.category-dropdown {
		position: relative;
	}
	.category-dropdown summary {
		padding: 1em 0.5em;
		border-bottom: 4px solid transparent;
		color: #e9eaff;
		cursor: pointer;
		list-style: none;
		white-space: nowrap;
	}
	.category-dropdown summary::-webkit-details-marker {
		display: none;
	}
	.mobile-menu-icon {
		display: none;
	}
	.category-dropdown summary::after {
		content: '▾';
		font-size: 0.75em;
		margin-left: 0.4em;
	}
	.category-dropdown.active summary,
	.category-dropdown[open] summary {
		border-bottom-color: #bfc4ff;
	}
	.category-dropdown__menu {
		position: absolute;
		top: calc(100% - 0.2rem);
		left: 0;
		z-index: 10;
		min-width: 14rem;
		max-height: min(60vh, 22rem);
		overflow-y: auto;
		padding: 0.4rem;
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 0.5rem;
		box-shadow: var(--box-shadow);
	}
	.category-dropdown__label {
		margin: 0.35rem 0.75rem 0.2rem;
		color: rgb(var(--gray));
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.category-dropdown__menu a {
		display: block;
		padding: 0.65rem 0.75rem;
		border-bottom: 0;
		border-radius: 0.35rem;
		color: rgb(var(--gray-dark));
		font-size: 0.92rem;
	}
	.category-dropdown__menu a:hover,
	.category-dropdown__menu a:focus-visible {
		background: rgb(var(--gray-light));
		color: rgb(var(--accent));
		outline: none;
	}
	.social-links a {
		display: flex;
		color: #e9eaff;
	}

	@media (max-width: 720px) {
		.site-header {
			padding: 0 0.75rem;
		}
		nav {
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
			min-height: 3.75rem;
			gap: 0;
		}
		.brand-wrapper {
			grid-column: 2;
			grid-row: 1;
			justify-self: center;
		}
		.brand {
			gap: 0.32rem;
			padding: 0.35rem 0;
		}
		.brand-mark :global(svg) {
			height: 1.5rem;
			width: calc(1.5rem * 100 / 124);
		}
		.brand-name {
			font-size: 1.08rem;
		}
		.internal-links {
			display: contents;
		}
		.internal-links > a {
			grid-column: 1;
			grid-row: 1;
			justify-self: start;
		}
		.internal-links > .category-dropdown {
			grid-column: 3;
			grid-row: 1;
			justify-self: end;
		}
		.internal-links > a,
		.category-dropdown summary {
			padding: 1rem 0.25rem;
			font-size: 0.92rem;
		}
		.category-dropdown summary {
			display: flex;
			align-items: center;
			justify-content: center;
			min-width: 2.35rem;
		}
		.category-dropdown summary::after {
			content: none;
		}
		.blog-label {
			display: none;
		}
		.mobile-menu-icon {
			display: block;
			width: 1.35rem;
			height: 1.35rem;
		}
		.category-dropdown__menu {
			left: auto;
			right: 0;
		}
		.social-links {
			display: none;
		}
	}
</style>
