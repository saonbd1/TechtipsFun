# Copy to .env and fill in. Load it with:  set -a; source .env; set +a
#
# Register an API consumer at https://instapaper.com/developers/ to get the
# consumer key + secret. Auth is OAuth 1.0a with x_auth (email/password) to
# exchange for a user token.
INSTAPAPER_CONSUMER_KEY=
INSTAPAPER_CONSUMER_SECRET=
INSTAPAPER_EMAIL=
INSTAPAPER_PASSWORD=

# Folder to save into and read from (case-insensitive). Defaults to "Tech News".
# The built-in lists unread / starred / archive also work.
INSTAPAPER_FOLDER=Tech News
