---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const siteUrl = new URL('/', Astro.site);
const contactSchema = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	'@id': `${siteUrl.href}contact-me/#webpage`,
	url: `${siteUrl.href}contact-me/`,
	name: `Contact Me - ${SITE_TITLE}`,
	description: 'Get in touch with Tech Tips in Fun for questions, feedback, or collaboration ideas.',
	isPartOf: { '@id': `${siteUrl.href}#website` },
	mainEntity: { '@id': `${siteUrl.href}#organization` },
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact Me - ${SITE_TITLE}`} description="Contact SaonBD, the author of Tech Tips in Fun, with questions, article feedback, corrections, or collaboration ideas." schema={contactSchema} />
	</head>
	<body>
		<Header />
		<main>
			<div class="contact-container">
				<h1>Contact Me</h1>
				<p>If you have any questions, feedback, or collaboration ideas, feel free to send me a message using the form below.</p>

				<form class="contact-form" action="https://formspree.io/f/xblyzrzq" method="POST">
					<div class="form-group">
						<label for="name">Your Name</label>
						<input type="text" id="name" name="name" required placeholder="John Doe" />
					</div>

					<div class="form-group">
						<label for="email">Your Email</label>
						<input type="email" id="email" name="email" required placeholder="john@example.com" />
					</div>

					<div class="form-group">
						<label for="message">Your Message</label>
						<textarea id="message" name="message" rows="5" required placeholder="Write your message here..."></textarea>
					</div>

					<button type="submit" class="submit-btn">Send Message</button>
				</form>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		display: flex;
		justify-content: center;
		padding: 3rem 1rem;
	}
	.contact-container {
		width: 100%;
		max-width: 720px;
	}
	h1 {
			font-size: 2.1rem;
		margin-bottom: 1rem;
		color: rgb(var(--black));
	}
	p {
		color: rgb(var(--gray-dark));
		margin-bottom: 2rem;
		font-size: 1.1rem;
		line-height: 1.6;
	}
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	label {
		font-weight: 600;
		color: rgb(var(--black));
		font-size: 0.95rem;
	}
	input, textarea {
		padding: 0.75rem 1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		font-family: inherit;
		font-size: 1rem;
		transition: border-color 0.2s, box-shadow 0.2s;
		background-color: white;
		color: rgb(var(--black));
	}
	input:focus, textarea:focus {
		outline: none;
		border-color: rgb(var(--accent));
		box-shadow: 0 0 0 3px rgba(var(--accent), 0.15);
	}
	.submit-btn {
		display: inline-block;
		width: 100%;
		background-color: rgb(var(--accent));
		color: white;
		padding: 0.85rem 2rem;
		border: none;
		border-radius: 8px;
		font-size: 1.1rem;
		font-weight: 600;
		cursor: pointer;
		text-align: center;
		transition: opacity 0.2s, transform 0.1s;
		box-shadow: 0 4px 12px rgba(var(--accent), 0.3);
	}
	.submit-btn:hover {
		opacity: 0.9;
	}
	.submit-btn:active {
		transform: scale(0.98);
	}
</style>
