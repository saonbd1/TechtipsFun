  "scenes": [
    {
      "type": "title",
      "kicker": "PC Troubleshooting",
      "title": "OneDrive Missing in Windows 11? How to Add It to File Explorer",
      "subtitle": "Learn how to add OneDrive to File Explorer on Windows 10 and Windows 11.",
      "image": {
        "src": "post-media/how-to-add-onedrive-to-windows-file-explorer/01-onedrive-windows11-cover.webp",
        "width": 1600,
        "height": 1280
      },
