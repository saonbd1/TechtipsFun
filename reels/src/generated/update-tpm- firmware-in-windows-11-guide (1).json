    {
      "type": "title",
      "kicker": "PC Troubleshooting",
      "title": "Update TPM firmware in Windows 11: A safe step-by-step guide",
      "subtitle": "Learn how to update TPM firmware in Windows 11, clear TPM safely, protect BitLocker data,…",
      "image": {
        "src": "post-media/update-tpm- firmware-in-windows-11-guide (1)/01-windows-wifi-cover.webp",
        "width": 1376,
        "height": 768
      },
      "durationInFrames": 183
    },
    {
      "type": "point",
      "kicker": "PC Troubleshooting",
      "heading": "Check the TPM status before making changes",
      "body": "Start by confirming that Windows can see the TPM and checking its specification version.",
      "durationInFrames": 284
    },
    {
      "type": "point",
      "kicker": "PC Troubleshooting",
      "heading": "Use Windows Security",
      "body": "Open Settings. Select Privacy & security. Select Windows Security. Select Device security.",
      "image": {
        "src": "post-media/update-tpm- firmware-in-windows-11-guide (1)/02-security-processor-details.webp",
        "width": 1293,
        "height": 565
      },
      "durationInFrames": 251
    },
    {
      "type": "point",
      "kicker": "PC Troubleshooting",
      "heading": "Use TPM Management",
      "body": "Press Windows + R. Type tpm.msc. Select OK. Read the status message in the TPM Management window.",
      "durationInFrames": 273
    },
    {
      "type": "point",
      "kicker": "PC Troubleshooting",
      "heading": "Prepare for a TPM firmware update",
      "body": "A TPM firmware update can change the TPM's state. A BIOS or UEFI update can also cause BitLocker to request its recovery key.",
      "durationInFrames": 330
    },
    {
      "type": "point",
      "kicker": "PC Troubleshooting",
      "heading": "How to update TPM firmware in Windows 11",
      "body": "TPM firmware usually comes from the computer or motherboard manufacturer.",
      "durationInFrames": 250
    },
    {
      "type": "point",
      "kicker": "PC Troubleshooting",
      "heading": "Step 1: Install Windows updates first",
      "body": "Open Settings. Select Windows Update. Select Check for updates. Install all applicable updates.",
      "image": {
        "src": "post-media/update-tpm- firmware-in-windows-11-guide (1)/03-windows-update.webp",
        "width": 1332,
        "height": 659
      },
      "durationInFrames": 297
    },
    {
      "type": "point",
      "kicker": "PC Troubleshooting",
      "heading": "Step 2: Find the correct firmware package",
      "body": "Go to your computer manufacturer's support page and search by the exact model name or service tag.",
      "durationInFrames": 319
    },
    {
      "type": "point",
      "kicker": "PC Troubleshooting",
      "heading": "Step 3: Install the firmware update",
      "body": "Close open applications. Connect the computer to AC power. Suspend BitLocker protection if the manufacturer's instructions require it.",
      "durationInFrames": 319
    },
    {
      "type": "outro",
      "heading": "Read the full article",
      "body": "New posts every week on the blog.",
      "url": "techtips.fun",
      "durationInFrames": 165
    }
