    {
      "type": "point",
      "kicker": "Web Development",
      "heading": "Vocabulary and encoding are different concepts",
      "body": "Schema.org provides a large vocabulary. JSON-LD, Microdata, and RDFa are ways to encode that vocabulary.",
      "durationInFrames": 284
    },
    {
      "type": "point",
      "kicker": "Web Development",
      "heading": "They target different ecosystems",
      "body": "Schema.org is widely used by search engines and other systems that consume structured data.",
      "durationInFrames": 250
    },
    {
      "type": "point",
      "kicker": "Web Development",
      "heading": "Use microformats for IndieWeb compatibility",
      "body": "Use microformats when your project needs h-card, h-entry, h-event, or related conventions.",
      "durationInFrames": 238
    },
